# =========================================================
# Mailgun Log Viewer
# Environment Configuration
#
# Every line below maps to a field in mailgun_log_viewer/config.py's
# Settings class. Anything not listed here has no effect on the app.
# =========================================================

# -----------------------------
# Application
# -----------------------------
APP_ENV=development

# -----------------------------
# Mode switch
# -----------------------------
# true  = the Events page shows realistic generated sample data, no Mailgun call is ever made.
# false = live calls, requires the credential fields below.
MOCK_MODE=true

# -----------------------------
# Mailgun credential
# -----------------------------
# Private API key: Mailgun dashboard -> Settings -> API Keys -> "Private API key".
# Sent as HTTP Basic Auth (username "api", this key as the password).
MAILGUN_API_KEY=

# Comma-separated sending domain(s) this app can query events for, e.g.
# "mail.example.com,updates.example.com". Sending -> Domains in the
# Mailgun dashboard lists what you have. The first is selected by default;
# the sidebar lets a session switch among the rest.
MAILGUN_DOMAINS=

# "us" or "eu". Mailgun's two regions use entirely different API base URLs,
# and a domain only exists in the region it was created in — check which on
# the domain's page under Sending -> Domains. Getting this wrong 401s every
# call exactly like a bad key would.
MAILGUN_REGION=us

# -----------------------------
# Networking
# -----------------------------
HTTP_TIMEOUT=30
REQUESTS_PER_SECOND=5

# Mailgun's events endpoint paginates up to 300 items/page via a cursor;
# these bound one "Fetch" click.
EVENTS_PAGE_SIZE=300
MAX_EVENTS_PER_QUERY=3000
